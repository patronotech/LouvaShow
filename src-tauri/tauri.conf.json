{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LouvaShow",
  "version": "0.5.0",
  "identifier": "app.louvashow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "operator",
        "title": "LouvaShow — Operador",
        "width": 1360,
        "height": 860,
        "minWidth": 760,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/bibles/THIRD_PARTY.txt": "BIBLE-NOTICES.txt"
    }
  }
}
